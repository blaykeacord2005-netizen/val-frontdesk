ELEVENLABS_VOICE_ID=
CHECKCHERRY_API_KEY=
ALERT_VAL=
ALERT_BLAYKE=
ALERT_MAX=
ALERT_DARRELL=

# Front desk placeholders. Leave blank until the real value is supplied.
VAL_BOOKING_EMAIL=
EMAIL_INTAKE_ENABLED=0
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
