# Required. Each one must be 16+ random characters. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=
VOICE_TOOL_SECRET=
ADMIN_PASSWORD=
CRON_SECRET=
PUBLIC_URL=https://your-app.up.railway.app
DB_PATH=/data/val.db
# Keep at 1 until a full test run passes
DRY_RUN=1
# Optional integrations
VAL_ICS_URL=
SMTP_USER=
SMTP_APP_PASSWORD=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
